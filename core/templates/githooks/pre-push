#!/usr/bin/env bash
# Relentless pre-push — refuse updates to main/master and any non-fast-forward (force) push.
# Installed into the consumer repo by core/scripts/install-githooks.sh.
set -euo pipefail

payload="$(cat || true)"  # intentional: empty stdin ok

# layers.githooks false: do nothing. A missing file, or a config with no layers
# object, keeps the check (1.4.11 installed these hooks). Invalid JSON exits
# and names the file. It must not be treated as layers-off.
githooks_layer_off() {
  local top cfg err has val
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"  # intentional fail-soft: not every cwd is a checkout
  cfg=""
  if [[ -n "$top" && -f "${top}/.relentless/config.json" ]]; then
    cfg="${top}/.relentless/config.json"
  elif [[ -f .relentless/config.json ]]; then
    cfg="$(pwd)/.relentless/config.json"
  fi
  [[ -n "$cfg" ]] || return 1
  if ! err="$(jq empty "$cfg" 2>&1)"; then
    echo "error: ${cfg} failed to parse: ${err}" >&2
    exit 1
  fi
  has="$(jq -r 'has("layers")' "$cfg")"
  if [[ "$has" != "true" ]]; then
    return 1
  fi
  val="$(jq -r '.layers.githooks // false' "$cfg")"
  [[ "$val" != "true" ]]
}

if githooks_layer_off; then
  exit 0
fi

zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -n "${remote_ref:-}" ]] || continue
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "relentless: refusing push to ${remote_ref}." >&2
      echo "Push a feature branch and open a pull request." >&2
      exit 1
      ;;
  esac
  if [[ "$local_sha" != "$zero" && "$remote_sha" != "$zero" ]]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      echo "relentless: refusing force-push of ${remote_ref} (not a fast-forward)." >&2
      echo "This includes --force, --force-with-lease, and a +refspec." >&2
      exit 1
    fi
  fi
done <<<"${payload}"

legacy="$(git rev-parse --git-common-dir)/hooks/pre-push"
self="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
legacy_abs="$(readlink -f "$legacy" 2>/dev/null || realpath "$legacy" 2>/dev/null || echo "$legacy")"
if [[ -x "$legacy" && "$legacy_abs" != "$self" ]]; then
  "$legacy" "$@" <<<"${payload}"
fi
