{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relentless project config",
  "type": "object",
  "required": [
    "decider",
    "merge",
    "workers"
  ],
  "properties": {
    "decider": {
      "type": "object",
      "required": [
        "name",
        "github"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name used in authorship markers"
        },
        "github": {
          "type": "string",
          "description": "GitHub login to assign when human:pending"
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "github": {
            "type": "string"
          }
        },
        "required": [
          "github"
        ]
      },
      "description": "Named workers; assignee while state:in-progress"
    },
    "merge": {
      "type": "object",
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "enum": [
            "auto",
            "human"
          ]
        },
        "allow_issue_override": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Who merges. Not a layer switch. Layer switches live under layers."
    },
    "base": {
      "type": "string",
      "description": "Repo default branch, read once at bootstrap. Issue branches start here."
    },
    "merge_methods": {
      "type": "object",
      "description": "Merge methods the repo allowed when bootstrap read it. Editable.",
      "properties": {
        "merge": {
          "type": "boolean"
        },
        "squash": {
          "type": "boolean"
        },
        "rebase": {
          "type": "boolean"
        }
      }
    },
    "layers": {
      "type": "object",
      "description": "Optional layers. Missing or false stays off. A fresh bootstrap writes every switch false. Upgrade defaults for an existing config are not this schema.",
      "additionalProperties": false,
      "properties": {
        "merge": { "type": "boolean" },
        "review": { "type": "boolean" },
        "qa": { "type": "boolean" },
        "worktrees": { "type": "boolean" },
        "decisions": { "type": "boolean" },
        "templates": { "type": "boolean" },
        "ci": { "type": "boolean" },
        "githooks": { "type": "boolean" },
        "docs": { "type": "boolean" }
      }
    },
    "rulesets": {
      "type": "object",
      "properties": {
        "apply": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in; fail soft if API denies"
        }
      }
    },
    "milestones": {
      "type": "object",
      "properties": {
        "require_outcome_section": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "stack": {
      "type": "string",
      "description": "Detected stack: node|python|go|rust|unknown"
    },
    "package_manager": {
      "type": [
        "string",
        "null"
      ],
      "description": "npm|pnpm|yarn|bun when stack=node"
    },
    "checks": {
      "type": "object",
      "properties": {
        "install": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "typecheck": {
          "type": "string"
        },
        "test": {
          "type": "string",
          "description": "Test command read from the repo's own CI. merge-if-ready runs this on the PR head when Actions quota skips CI."
        },
        "build": {
          "type": "string"
        }
      },
      "description": "Commands read once from the repo. A fresh bootstrap fills test from the repo's workflow."
    }
  }
}
